{
  "name": "sworld-blog",
  "description": "Sworld 的博客",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "author": "Sworld <61224072+mcthesw@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://blog.sworld.club",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcthesw/sworld-blog.git"
  },
  "scripts": {
    "dev": "node quartz/bootstrap-cli.mjs build --serve --port 43781 --wsPort 43782",
    "build": "pnpm run install-plugins && node quartz/bootstrap-cli.mjs build",
    "install-plugins": "tsx quartz/plugins/loader/install-plugins.ts",
    "check": "tsc --noEmit && tsc -p scripts/tsconfig.json && node --test scripts/*.test.mjs",
    "test": "tsc -p scripts/tsconfig.json && node --test scripts/*.test.mjs",
    "sync": "node scripts/sync-siyuan.mjs",
    "install-plugin": "node scripts/install-siyuan-plugin.mjs",
    "privacy": "tsc -p scripts/tsconfig.json && node .local/scripts/privacy-guard.js --all",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
