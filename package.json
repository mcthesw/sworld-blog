{
  "name": "sworld-s-world",
  "type": "module",
  "version": "1.0.0",
  "description": "Sworld的博客",
  "packageManager": "pnpm@10.28.0",
  "author": "Sworld <61224072+mcthesw@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @sworld/vuepress-plugin-image-webp build && vuepress dev docs",
    "build": "pnpm --filter @sworld/vuepress-plugin-image-webp build && vuepress build docs --clean-cache --clean-temp",
    "preview": "http-server docs/.vuepress/dist",
    "new": "tsc -p scripts/tsconfig.json && node .local/scripts/new.js",
    "check": "tsc -p scripts/tsconfig.json && node --test scripts/*.test.mjs && pnpm build",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@sworld/vuepress-plugin-image-webp": "workspace:*",
    "@vuepress/bundler-vite": "2.0.0-rc.26",
    "autoprefixer": "10.4.20",
    "exifr": "^7.1.3",
    "http-server": "^14.1.1",
    "postcss": "8.4.41",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.3",
    "vue": "^3.5.26",
    "vuepress": "2.0.0-rc.26",
    "vuepress-theme-plume": "1.0.0-rc.187"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.0.0"
  },
  "dependencies": {
    "mermaid": "^11.12.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec tsc -p scripts/tsconfig.json && node .local/scripts/image-webp.js --staged --stage && node .local/scripts/privacy-guard.js --staged"
  }
}
